---
const avatar = '/images/seo-xiaoping-avatar.jpg';

const traits = [
  { icon: 'fa-solid fa-hammer', label: '死磕谷歌 SEO 的隔壁老王' },
  { icon: 'fa-solid fa-fish', label: 'SEO 捕鱼大师' },
  { icon: 'fa-solid fa-cart-shopping', label: '10 年独立站卖家' },
  { icon: 'fa-solid fa-language', label: '纯血小语种 SEO 专家' },
  { icon: 'fa-solid fa-robot', label: 'AI Vibe Coding 玩家' },
];

const features = [
  {
    icon: 'fa-solid fa-graduation-cap',
    title: '教育背景',
    body: '商务日语专业，具备扎实的日语商务沟通能力，助力小语种市场开拓。',
    tone: 'text-[#f59e0b] border-[#f59e0b]/30 bg-[#f59e0b]/10',
  },
  {
    icon: 'fa-solid fa-route',
    title: '职业轨迹',
    body: 'B2B 外贸、亚马逊运营、独立站卖家、SEO 实战专家、创业者、培训师。',
    tone: 'text-sky-400 border-sky-400/30 bg-sky-400/10',
  },
  {
    icon: 'fa-solid fa-star',
    title: '核心优势',
    body: '兼具外贸业务、电商运营与技术 SEO 三重能力，结合商业需求与技术优化。',
    tone: 'text-[#d4087c] border-[#d4087c]/30 bg-[#d4087c]/10',
  },
  {
    icon: 'fa-solid fa-bullseye',
    title: '内容定位',
    body: '聚焦谷歌 SEO、小语种 SEO、AI 建站自动化、联盟营销四大领域。',
    tone: 'text-emerald-400 border-emerald-400/30 bg-emerald-400/10',
  },
];
---

<section id="about" class="py-16" aria-labelledby="about-title">
  <div class="mb-12 text-center">
    <p class="mb-3 text-xs font-bold uppercase tracking-[0.35em] text-[#f59e0b]">About The Founder</p>
    <h2 id="about-title" class="mb-4 text-4xl font-black tracking-tight text-white">站长简介</h2>
    <div class="mx-auto h-1 w-20 rounded-full bg-gradient-to-r from-[#f59e0b] via-[#d95300] to-[#d4087c]"></div>
  </div>

  <div class="grid items-center gap-10 lg:grid-cols-[0.9fr_1.1fr]">
    <div class="relative group">
      <div class="absolute -inset-2 rounded-[1.75rem] bg-gradient-to-r from-[#d95300] to-[#d4087c] opacity-30 blur-xl transition duration-500 group-hover:opacity-55"></div>
      <figure class="relative overflow-hidden rounded-3xl border border-white/10 bg-white/5 p-3 shadow-2xl backdrop-blur-md">
        <img
          src={avatar}
          alt="SEO 小平头像"
          width="640"
          height="640"
          loading="lazy"
          decoding="async"
          class="aspect-square w-full rounded-2xl object-cover"
        />
        <figcaption class="absolute bottom-8 left-8 rounded-xl border border-white/10 bg-[#17171c]/80 px-4 py-2 text-sm font-black text-[#f59e0b] shadow-lg backdrop-blur-md">
          SEO 小平
        </figcaption>
      </figure>
    </div>

    <div>
      <h3 class="mb-6 text-3xl font-black leading-tight tracking-tight text-white md:text-4xl">
        死磕谷歌 SEO 的<br />独立站实战派博主
      </h3>
      <p class="mb-8 text-lg leading-9 text-white/72">
        SEO 小平，籍贯四川，居于深圳。自 2016 年起深耕跨境电商独立站 SEO 运营，是一位拥有十年外贸经验的创业者、C 端 B 端双赛道玩家，只专注谷歌 SEO 引流。作为知名 SEO 博主与培训师，多年以来使用 AI 做全球各个国家的纯血小语种独立站 SEO，帮助外贸客户开拓海外市场，并持续输出独立站谷歌 SEO 领域的实战干货。
      </p>

      <div class="mb-10 flex flex-wrap gap-3">
        {traits.map((trait) => (
          <span class="inline-flex items-center gap-2 rounded-xl border border-white/10 bg-white/5 px-3 py-2 text-sm font-semibold text-white/78 transition hover:border-[#d95300]/40 hover:bg-[#d95300]/15 hover:text-white">
            <i class={`${trait.icon} text-[#f59e0b]`} aria-hidden="true"></i>
            <span>{trait.label}</span>
          </span>
        ))}
      </div>

      <div class="grid gap-5 sm:grid-cols-2">
        {features.map((feature) => (
          <article class="rounded-2xl border border-white/10 bg-white/5 p-6 shadow-[0_18px_54px_rgba(0,0,0,0.2)] backdrop-blur-md">
            <div class={`mb-4 grid h-11 w-11 place-items-center rounded-xl border text-xl ${feature.tone}`}>
              <i class={feature.icon} aria-hidden="true"></i>
            </div>
            <h3 class="mb-2 text-lg font-bold tracking-tight text-white">{feature.title}</h3>
            <p class="text-sm leading-7 text-white/62">{feature.body}</p>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
