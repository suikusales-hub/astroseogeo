---
import { getCollection } from 'astro:content';

interface SidebarPost {
  title: string;
  slug: string;
}

interface SidebarCategory {
  slug: string;
  name: string;
}

interface Props {
  categories: SidebarCategory[];
  posts: SidebarPost[];
}

const { categories, posts } = Astro.props as Props;

const [sidebar] = await getCollection('sidebar');
const settings = sidebar?.data;
const categoriesTitle = settings?.categoriesTitle ?? '全部文章分类';
const recommendedTitle = settings?.recommendedTitle ?? '推荐阅读';
const cta = settings?.cta;
---

<aside class="rounded-2xl border border-white/10 bg-white/5 p-5 shadow-[0_24px_80px_rgba(0,0,0,0.25)] backdrop-blur-md" aria-label="文章分类与推荐文章">
  <div class="grid gap-6">
    <section aria-labelledby="sidebar-categories">
      <h2 id="sidebar-categories" class="mb-4 text-lg font-black tracking-tight text-white">{categoriesTitle}</h2>
      <nav class="grid gap-2" aria-label={categoriesTitle}>
        {categories.map((category) => (
          <a href={`/${category.slug}`} class="inline-flex items-center gap-2 rounded-full px-3 py-1.5 text-sm font-extrabold text-white/72 transition hover:bg-[#d95300]/15 hover:text-[#f59e0b]">
            <i class="fa-solid fa-folder-open" aria-hidden="true"></i>
            <span>{category.name}</span>
          </a>
        ))}
      </nav>
    </section>

    <section aria-labelledby="sidebar-recommended-posts">
      <h2 id="sidebar-recommended-posts" class="mb-4 text-lg font-black tracking-tight text-white">{recommendedTitle}</h2>
      <ol class="grid gap-2">
        {posts.map((post, index) => (
          <li class="grid grid-cols-[1.5rem_minmax(0,1fr)] gap-2 text-sm leading-6">
            <span class="text-xs font-black text-[#f59e0b]/80">{String(index + 1).padStart(2, '0')}</span>
            <a href={`/${post.slug}`} class="text-white/70 transition hover:text-[#f59e0b]">
              {post.title}
            </a>
          </li>
        ))}
      </ol>
    </section>

    {cta?.enabled && (
      <section class="rounded-2xl border border-[#d95300]/30 bg-gradient-to-br from-[#d95300]/15 to-white/5 p-5" aria-labelledby="sidebar-cta">
        <h2 id="sidebar-cta" class="mb-2 text-base font-black tracking-tight text-white">{cta.title}</h2>
        <p class="mb-3 text-sm leading-6 text-white/70">{cta.text}</p>
        <a href={cta.buttonHref} class="inline-flex min-h-10 items-center justify-center rounded-full bg-gradient-to-r from-[#f59e0b] to-[#d95300] px-5 text-sm font-bold text-white shadow-[0_0_18px_rgba(217,83,0,0.3)] transition hover:brightness-110">
          {cta.buttonLabel}
        </a>
      </section>
    )}
  </div>
</aside>