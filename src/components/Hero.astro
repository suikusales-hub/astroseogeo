<style>
  .hero-shell {
    left: 50%;
    width: 100vw;
    margin-left: -50vw;
    margin-right: -50vw;
  }

  .btn-primary {
    position: relative;
    overflow: hidden;
    background: linear-gradient(135deg, #f59e0b 0%, #d95300 55%, #d4087c 100%);
  }

  .btn-primary::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.18), transparent);
    transition: left 0.5s ease;
  }

  .btn-primary:hover::before {
    left: 100%;
  }

  .btn-primary span,
  .btn-primary i {
    position: relative;
    z-index: 1;
  }
</style>

<script>
  const canvas = document.getElementById('starfield');
  const ctx = canvas instanceof HTMLCanvasElement ? canvas.getContext('2d') : null;
  let width = 0;
  let height = 0;
  let stars = [];

  function initStars() {
    if (!canvas || !ctx) return;
    const rect = canvas.getBoundingClientRect();
    const dpr = window.devicePixelRatio || 1;
    width = Math.max(1, Math.floor(rect.width));
    height = Math.max(1, Math.floor(rect.height));
    canvas.width = Math.floor(width * dpr);
    canvas.height = Math.floor(height * dpr);
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    stars = [];

    const count = Math.min(800, Math.max(260, Math.floor((width * height) / 1400)));
    for (let i = 0; i < count; i += 1) {
      stars.push({
        x: Math.random() * width,
        y: Math.random() * height,
        r: Math.random() * 1.5,
        opacity: Math.random(),
        speedX: (Math.random() - 0.5) * 0.2 + 0.1,
        speedY: (Math.random() - 0.5) * 0.2 - 0.1,
        twinkleSpeed: 0.01 + Math.random() * 0.02,
        twinkleDir: Math.random() > 0.5 ? 1 : -1,
      });
    }
  }

  function drawStars() {
    if (!ctx) return;
    ctx.clearRect(0, 0, width, height);

    stars.forEach((star) => {
      star.x += star.speedX;
      star.y += star.speedY;

      if (star.x < 0) star.x = width;
      if (star.x > width) star.x = 0;
      if (star.y < 0) star.y = height;
      if (star.y > height) star.y = 0;

      star.opacity += star.twinkleSpeed * star.twinkleDir;
      if (star.opacity <= 0.1) {
        star.opacity = 0.1;
        star.twinkleDir = 1;
      } else if (star.opacity >= 1) {
        star.opacity = 1;
        star.twinkleDir = -1;
      }

      ctx.beginPath();
      ctx.arc(star.x, star.y, star.r, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(255, 255, 255, ${star.opacity})`;
      ctx.fill();
    });

    requestAnimationFrame(drawStars);
  }

  if (ctx) {
    window.addEventListener('resize', initStars, { passive: true });
    initStars();
    drawStars();
  }
</script>
