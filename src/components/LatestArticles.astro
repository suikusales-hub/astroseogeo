---
import LatestPostCard from './LatestPostCard.astro';

interface PostPreview {
  title: string;
  description: string;
  pubDate: Date;
  heroImage: string;
  tags: string[];
  slug: string;
}

interface Props {
  posts: PostPreview[];
}

const { posts } = Astro.props as Props;
---

<section class="py-14" aria-labelledby="latest-title">
  <div class="mb-10 flex items-end justify-between gap-6">
    <div>
      <p class="mb-3 text-xs font-bold uppercase tracking-[0.35em] text-[#f59e0b]">Latest Insights</p>
      <h2 id="latest-title" class="mb-4 text-4xl font-black tracking-tight text-white">最新干货分享</h2>
      <div class="h-1 w-20 rounded-full bg-gradient-to-r from-[#f59e0b] via-[#d95300] to-[#d4087c]"></div>
    </div>
    <a href="/seo-tutorial" class="hidden items-center gap-2 text-sm font-bold text-white/55 transition hover:text-[#f59e0b] md:inline-flex">
      <span>查看全部</span>
      <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
    </a>
  </div>

  {posts.length > 0 ? (
    <div class="mb-10 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => (
        <LatestPostCard post={post} />
      ))}
    </div>
  ) : (
    <div class="rounded-2xl border border-white/10 bg-white/5 p-8 text-center shadow-[0_24px_80px_rgba(0,0,0,0.25)] backdrop-blur-md">
      <p class="font-semibold text-white/70">最新文章正在整理中。</p>
    </div>
  )}

  <div class="text-center md:hidden">
    <a href="/seo-tutorial" class="inline-flex min-h-12 w-full items-center justify-center rounded-full border border-white/12 bg-white/5 px-6 font-bold text-white backdrop-blur-md transition hover:border-[#d95300] hover:text-[#f59e0b]">
      查看全部干货
    </a>
  </div>
</section>
