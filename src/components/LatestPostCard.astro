---
import PostCover from './PostCover.astro';

interface PostPreview {
  title: string;
  description: string;
  pubDate: Date;
  heroImage: string;
  tags: string[];
  slug: string;
}

interface Props {
  post: PostPreview;
}

const { post } = Astro.props as Props;
const primaryTag = post.tags[0] ?? 'SEO';
const dateLabel = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
}).format(post.pubDate);
---

<article class="behance-card group flex min-h-full flex-col overflow-hidden rounded-2xl border border-white/10 bg-white/5 shadow-[0_24px_80px_rgba(0,0,0,0.25)] backdrop-blur-md transition hover:-translate-y-1 hover:border-[#d95300]/35 hover:shadow-[0_28px_90px_rgba(217,83,0,0.18)]">
  <a href={`/${post.slug}`} class="relative block overflow-hidden" aria-label={post.title}>
    <PostCover image={post.heroImage} title={post.title} variant="card" hoverable={true} />
    <div class="absolute inset-0 flex items-start justify-end bg-black/0 p-4 opacity-0 transition group-hover:bg-black/40 group-hover:opacity-100">
      <span class="grid h-10 w-10 place-items-center rounded-full bg-white/10 text-white backdrop-blur-md transition group-hover:bg-[#d95300]">
        <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
      </span>
    </div>
  </a>

  <div class="flex flex-1 flex-col bg-black/10 p-6">
    <div class="mb-3 flex flex-wrap items-center gap-x-4 gap-y-2 text-xs font-bold text-[#f59e0b]">
      <span class="inline-flex items-center gap-1">
        <i class="fa-solid fa-calendar" aria-hidden="true"></i>
        <time datetime={post.pubDate.toISOString()}>{dateLabel}</time>
      </span>
      <span class="inline-flex items-center gap-1">
        <i class="fa-solid fa-tag" aria-hidden="true"></i>
        <span>{primaryTag}</span>
      </span>
    </div>

    <h3 class="mb-2 text-[18px] font-extrabold leading-snug tracking-tight text-white transition group-hover:text-[#f59e0b]">
      <a href={`/${post.slug}`}>{post.title}</a>
    </h3>
    <p class="line-clamp-2 text-sm leading-7 text-white/68">{post.description}</p>

    <div class="mt-4 flex items-center gap-2 border-t border-white/5 pt-4">
      <img src="/images/seo-xiaoping-avatar.jpg" alt="SEO小平" class="h-7 w-7 rounded-full border border-white/20 object-cover" loading="lazy" decoding="async" />
      <span class="text-xs font-medium text-white/70">SEO小平</span>
    </div>
  </div>
</article>
