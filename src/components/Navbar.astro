---
import SearchBox from './SearchBox.astro';

interface NavItem {
  label: string;
  href: string;
}

interface Props {
  items?: NavItem[];
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  items = [
    { label: '首页', href: '/' },
    { label: 'SEO教程', href: '/seo-tutorial' },
    { label: 'AI搜索', href: '/ai-geo' },
    { label: '案例库', href: '/case-study' },
    { label: '关于', href: '/about' },
  ],
  ctaLabel = '咨询',
  ctaHref = '/contact',
} = Astro.props as Props;

const currentPath = normalizePath(Astro.url?.pathname ?? '/');

function normalizePath(pathname: string) {
  const normalized = pathname.toLowerCase().replace(/\.html$/, '').replace(/\/+$/, '');
  return normalized === '' ? '/' : normalized;
}
---

<header class="site-header">
  <nav class="navbar glass-panel" aria-label="全站导航">
    <div class="navbar-inner">
      <a class="brand" href="/" aria-label="SEO小平首页">
        <img class="brand-mark" src="/images/seo-xiaoping-avatar.jpg" alt="" width="40" height="40" />
        <span class="brand-name">SEO<span>小平</span></span>
      </a>

      <div class="nav-links desktop-links">
        {items.map((item) => (
          <a
            class:list={['nav-link', normalizePath(item.href) === currentPath && 'is-active']}
            href={item.href}
            aria-current={normalizePath(item.href) === currentPath ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))}
      </div>

      <SearchBox />

      <a class="nav-cta desktop-cta" href={ctaHref}>
        <i class="fa-solid fa-paper-plane" aria-hidden="true"></i>
        <span>{ctaLabel}</span>
      </a>

      <details class="mobile-menu">
        <summary aria-label="打开导航菜单">
          <i class="fa-solid fa-bars" aria-hidden="true"></i>
        </summary>
        <div class="mobile-panel glass-panel">
          {items.map((item) => (
            <a
              class:list={['mobile-link', normalizePath(item.href) === currentPath && 'is-active']}
              href={item.href}
              aria-current={normalizePath(item.href) === currentPath ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))}
          <a class="mobile-cta" href={ctaHref}>
            <i class="fa-solid fa-paper-plane" aria-hidden="true"></i>
            <span>{ctaLabel}</span>
          </a>
        </div>
      </details>
    </div>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    padding: 0.75rem 0;
  }

  .navbar {
    position: relative;
    width: 100%;
    margin: 0;
    padding: 0 clamp(1rem, 3vw, 2rem);
    border-radius: 0;
    background: rgba(23, 23, 28, 0.82);
  }

  .navbar-inner {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1rem;
    width: min(var(--site-content-width), 100%);
    min-height: 4.5rem;
    margin: 0 auto;
    padding: 0.65rem 0;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    min-width: max-content;
    color: #fff;
    font-weight: 900;
    letter-spacing: 0.04em;
    text-decoration: none;
  }

  .brand span span {
    color: rgba(255, 255, 255, 0.62);
    font-weight: 350;
  }

  .brand-mark {
    display: block;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
    border: 1px solid rgba(217, 83, 0, 0.5);
    background: #fff;
    object-fit: cover;
    box-shadow: 0 0 24px rgba(217, 83, 0, 0.28);
  }

  .brand-name {
    font-size: 1.15rem;
  }

  .nav-links {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    flex: 1;
  }

  .nav-link,
  .mobile-link {
    border-radius: 999px;
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.95rem;
    font-weight: 650;
    text-decoration: none;
    transition:
      background 180ms ease,
      color 180ms ease;
  }

  .nav-link {
    padding: 0.7rem 0.95rem;
  }

  .nav-link:hover,
  .nav-link.is-active,
  .mobile-link:hover,
  .mobile-link.is-active {
    background: rgba(217, 83, 0, 0.16);
    color: #fff;
  }

  .nav-cta,
  .mobile-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border-radius: 999px;
    background: linear-gradient(135deg, var(--color-accent), var(--color-primary));
    color: #fff;
    font-weight: 800;
    line-height: 1;
    text-decoration: none;
    box-shadow: 0 0 18px rgba(217, 83, 0, 0.35);
  }

  .nav-cta {
    min-height: 2.65rem;
    padding: 0 1.15rem;
  }

  .mobile-menu {
    display: none;
    margin-left: auto;
  }

  .mobile-menu summary {
    display: grid;
    width: 2.65rem;
    height: 2.65rem;
    place-items: center;
    border-radius: 999px;
    color: #fff;
    cursor: pointer;
    list-style: none;
  }

  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }

  .mobile-menu[open] summary {
    background: rgba(217, 83, 0, 0.16);
  }

  .mobile-panel {
    position: absolute;
    right: 0.65rem;
    top: calc(100% + 0.6rem);
    display: grid;
    width: min(18rem, calc(100vw - 2rem));
    gap: 0.35rem;
    padding: 0.65rem;
    border-radius: 20px;
    background: rgba(13, 13, 18, 0.94);
  }

  .mobile-link {
    padding: 0.85rem 0.9rem;
  }

  .mobile-cta {
    min-height: 2.75rem;
    margin-top: 0.25rem;
  }

  @media (max-width: 820px) {
    .desktop-links,
    .desktop-cta {
      display: none;
    }

    .mobile-menu {
      display: block;
    }

    .navbar {
      padding-inline: clamp(1rem, 5vw, 1.25rem);
    }

    .navbar-inner {
      min-height: 3.75rem;
    }
  }
</style>
