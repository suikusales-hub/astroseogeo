---
interface Props {
  image: string;
  title: string;
  alt?: string;
  variant?: 'card' | 'hero' | 'archive';
  loading?: 'lazy' | 'eager';
  decoding?: 'async' | 'sync' | 'auto';
  hoverable?: boolean;
}

const {
  image,
  title,
  alt = title,
  variant = 'card',
  loading = 'lazy',
  decoding = 'async',
  hoverable = false,
} = Astro.props as Props;

const isDefaultCover = image === '/images/default-post.png';
const rootClass =
  variant === 'hero'
    ? 'post-cover post-cover--hero'
    : variant === 'archive'
      ? 'post-cover post-cover--archive'
      : 'post-cover post-cover--card';
---

<div class:list={[rootClass, hoverable && 'post-cover--hoverable']}>
  <img class="post-cover__image" src={image} alt={alt} loading={loading} decoding={decoding} />

  {isDefaultCover && (
    <div class="post-cover__overlay" aria-hidden="true">
      <div class="post-cover__overlay-inner">
        <span class="post-cover__eyebrow">SEO XIAOPING</span>
        <strong class="post-cover__title">{title}</strong>
      </div>
    </div>
  )}
</div>

<style>
  .post-cover {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    width: 100%;
    border-radius: 18px;
  }

  .post-cover--card {
    aspect-ratio: 4 / 3;
  }

  .post-cover--archive {
    aspect-ratio: 16 / 10;
  }

  .post-cover--hero {
    aspect-ratio: 16 / 9;
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.32);
  }

  .post-cover__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms ease;
  }

  .post-cover--hoverable:hover .post-cover__image {
    transform: scale(1.05);
  }

  .post-cover__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    padding: clamp(1rem, 2vw, 1.5rem);
    background:
      linear-gradient(180deg, rgba(15, 10, 8, 0.06) 0%, rgba(15, 10, 8, 0.22) 38%, rgba(15, 10, 8, 0.82) 100%);
    pointer-events: none;
  }

  .post-cover__overlay-inner {
    width: min(100%, 54rem);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 18px;
    background: rgba(20, 14, 10, 0.34);
    box-shadow: 0 18px 54px rgba(0, 0, 0, 0.24);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    padding: clamp(0.85rem, 2vw, 1.2rem);
  }

  .post-cover__eyebrow {
    display: inline-flex;
    max-width: 100%;
    margin-bottom: 0.55rem;
    border-radius: 999px;
    background: rgba(239, 125, 0, 0.18);
    color: #ffd6a6;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    line-height: 1;
    padding: 0.42rem 0.65rem;
  }

  .post-cover__title {
    display: -webkit-box;
    overflow: hidden;
    color: #fffaf4;
    font-weight: 900;
    line-height: 1.3;
    text-wrap: balance;
    word-break: break-word;
    overflow-wrap: anywhere;
    -webkit-box-orient: vertical;
  }

  .post-cover--card .post-cover__title {
    font-size: clamp(1rem, 2.1vw, 1.38rem);
    -webkit-line-clamp: 3;
  }

  .post-cover--archive .post-cover__title {
    font-size: clamp(0.96rem, 1.5vw, 1.16rem);
    -webkit-line-clamp: 3;
  }

  .post-cover--hero .post-cover__title {
    font-size: clamp(1.15rem, 2.8vw, 2.15rem);
    -webkit-line-clamp: 4;
  }

  @media (max-width: 680px) {
    .post-cover__overlay {
      padding: 0.9rem;
    }

    .post-cover__overlay-inner {
      padding: 0.8rem;
    }

    .post-cover__eyebrow {
      margin-bottom: 0.45rem;
      font-size: 0.66rem;
      padding: 0.36rem 0.58rem;
    }

    .post-cover--card .post-cover__title {
      font-size: 0.96rem;
    }

    .post-cover--archive .post-cover__title {
      font-size: 0.92rem;
    }

    .post-cover--hero .post-cover__title {
      font-size: 1.02rem;
      -webkit-line-clamp: 3;
    }
  }
</style>
