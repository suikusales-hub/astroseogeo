<div class="site-search" data-site-search>
  <button class="search-trigger" type="button" aria-label="打开站内搜索" data-search-trigger>
    <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
    <span>搜索</span>
  </button>

  <div class="search-popover" data-search-popover hidden>
    <div class="search-panel glass-panel">
      <div class="search-field">
        <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
        <input type="search" placeholder="搜索 SEO、GEO、小语种、独立站..." autocomplete="off" data-search-input />
        <button type="button" aria-label="关闭搜索" data-search-close>
          <i class="fa-solid fa-xmark" aria-hidden="true"></i>
        </button>
      </div>
      <div class="search-status" data-search-status>输入关键词开始搜索</div>
      <div class="search-results" data-search-results></div>
    </div>
  </div>
</div>

<style>
  .site-search {
    position: relative;
  }

  .search-trigger {
    display: inline-flex;
    min-height: 2.65rem;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.045);
    color: rgba(255, 255, 255, 0.82);
    cursor: pointer;
    font: inherit;
    font-size: 0.92rem;
    font-weight: 750;
    padding: 0 1rem;
    transition:
      border-color 180ms ease,
      background 180ms ease,
      color 180ms ease;
  }

  .search-trigger:hover,
  .search-trigger[aria-expanded='true'] {
    border-color: rgba(217, 83, 0, 0.4);
    background: rgba(217, 83, 0, 0.14);
    color: #fff;
  }

  .search-popover {
    position: absolute;
    right: 0;
    top: calc(100% + 0.75rem);
    z-index: 60;
    width: min(42rem, calc(100vw - 2rem));
  }

  .search-panel {
    overflow: hidden;
    border-radius: 24px;
    background: rgba(13, 13, 18, 0.96);
  }

  .search-field {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.85rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding: 0.95rem 1rem;
  }

  .search-field > i {
    color: #f59e0b;
  }

  .search-field input {
    width: 100%;
    border: 0;
    outline: 0;
    background: transparent;
    color: #fff;
    font: inherit;
    font-size: 1rem;
  }

  .search-field input::placeholder {
    color: rgba(255, 255, 255, 0.42);
  }

  .search-field button {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border: 0;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.07);
    color: rgba(255, 255, 255, 0.72);
    cursor: pointer;
  }

  .search-status {
    padding: 0.8rem 1rem 0;
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.86rem;
  }

  .search-results {
    display: grid;
    max-height: min(70vh, 34rem);
    gap: 0.45rem;
    overflow-y: auto;
    padding: 0.8rem;
  }

  .search-result {
    display: grid;
    gap: 0.35rem;
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.035);
    color: inherit;
    padding: 0.9rem;
    text-decoration: none;
    transition:
      border-color 180ms ease,
      background 180ms ease,
      transform 180ms ease;
  }

  .search-result:hover {
    border-color: rgba(217, 83, 0, 0.35);
    background: rgba(217, 83, 0, 0.1);
    transform: translateY(-1px);
  }

  .search-result-title {
    color: #fff;
    font-size: 0.98rem;
    font-weight: 850;
    line-height: 1.45;
  }

  .search-result-excerpt {
    color: rgba(255, 255, 255, 0.64);
    font-size: 0.88rem;
    line-height: 1.65;
  }

  .search-result-excerpt mark {
    border-radius: 0.25rem;
    background: rgba(245, 158, 11, 0.24);
    color: #fff;
    padding: 0.05rem 0.16rem;
  }

  .search-result-url {
    color: rgba(245, 158, 11, 0.78);
    font-size: 0.76rem;
    word-break: break-all;
  }

  @media (max-width: 820px) {
    .search-trigger span {
      display: none;
    }

    .search-trigger {
      width: 2.65rem;
      padding: 0;
    }

    .search-popover {
      position: fixed;
      inset: 5.25rem 1rem auto 1rem;
      width: auto;
    }
  }
</style>

<script>
  const root = document.querySelector('[data-site-search]');
  const trigger = root?.querySelector('[data-search-trigger]');
  const popover = root?.querySelector('[data-search-popover]');
  const input = root?.querySelector('[data-search-input]');
  const closeButton = root?.querySelector('[data-search-close]');
  const status = root?.querySelector('[data-search-status]');
  const results = root?.querySelector('[data-search-results]');
  let pagefindPromise;
  let searchTimer;

  const escapeHtml = (value) =>
    value.replace(/[&<>'"]/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' })[char]);

  function openSearch() {
    if (!popover || !trigger || !input) return;
    popover.hidden = false;
    trigger.setAttribute('aria-expanded', 'true');
    window.setTimeout(() => input.focus(), 0);
  }

  function closeSearch() {
    if (!popover || !trigger) return;
    popover.hidden = true;
    trigger.setAttribute('aria-expanded', 'false');
  }

  async function loadPagefind() {
    if (!pagefindPromise) {
      const pagefindPath = `${window.location.origin}/pagefind/pagefind.js`;
      pagefindPromise = import(/* @vite-ignore */ pagefindPath);
    }
    return pagefindPromise;
  }

  async function runSearch(query) {
    if (!status || !results) return;
    const trimmed = query.trim();
    results.innerHTML = '';

    if (trimmed.length < 2) {
      status.textContent = '输入至少 2 个字符开始搜索';
      return;
    }

    status.textContent = '正在搜索...';

    try {
      const pagefind = await loadPagefind();
      const search = await pagefind.search(trimmed);
      const topResults = await Promise.all(search.results.slice(0, 8).map((result) => result.data()));

      if (topResults.length === 0) {
        status.textContent = `没有找到“${trimmed}”相关内容`;
        return;
      }

      status.textContent = `找到 ${search.results.length} 条结果，显示前 ${topResults.length} 条`;
      results.innerHTML = topResults
        .map((item) => {
          const title = item.meta?.title || item.url;
          const excerpt = item.excerpt || item.content || '';
          return `<a class="search-result" href="${item.url}">
            <span class="search-result-title">${escapeHtml(title)}</span>
            <span class="search-result-excerpt">${excerpt}</span>
            <span class="search-result-url">${escapeHtml(item.url)}</span>
          </a>`;
        })
        .join('');
    } catch (error) {
      status.textContent = '搜索索引还没有加载成功，请稍后再试';
      console.error('Pagefind search failed', error);
    }
  }

  trigger?.addEventListener('click', () => {
    if (popover?.hidden) {
      openSearch();
    } else {
      closeSearch();
    }
  });

  closeButton?.addEventListener('click', closeSearch);

  input?.addEventListener('input', (event) => {
    window.clearTimeout(searchTimer);
    searchTimer = window.setTimeout(() => runSearch(event.target.value), 180);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeSearch();
    if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault();
      openSearch();
    }
  });

  document.addEventListener('click', (event) => {
    if (!root?.contains(event.target)) closeSearch();
  });
</script>
