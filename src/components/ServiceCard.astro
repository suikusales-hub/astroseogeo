---
interface Props {
  icon: string;
  title: string;
  description: string;
  href: string;
}

const { icon, title, description, href } = Astro.props as Props;
---

<article class="group flex min-h-full flex-col rounded-2xl border border-white/10 bg-white/5 p-8 shadow-[0_24px_80px_rgba(0,0,0,0.25)] backdrop-blur-md transition hover:-translate-y-1 hover:border-[#d95300]/35 hover:shadow-[0_28px_90px_rgba(217,83,0,0.18)]">
  <div class="mb-6 grid h-14 w-14 place-items-center rounded-xl bg-white/5 text-2xl text-[#f59e0b] shadow-sm transition group-hover:scale-105 group-hover:bg-[#d95300] group-hover:text-white">
    <i class={icon} aria-hidden="true"></i>
  </div>
  <h3 class="mb-3 text-xl font-extrabold tracking-tight text-white">{title}</h3>
  <p class="mb-6 line-clamp-3 flex-1 text-sm leading-7 text-white/68">{description}</p>
  <a href={href} class="inline-flex items-center gap-2 text-sm font-bold text-[#f59e0b] transition hover:text-white">
    <span>了解更多</span>
    <i class="fa-solid fa-arrow-right text-xs" aria-hidden="true"></i>
  </a>
</article>
