---
import { existsSync } from 'node:fs';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ArticleSidebar from '../components/ArticleSidebar.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryArchive from '../components/CategoryArchive.astro';
import PostCover from '../components/PostCover.astro';
import { toPostSlug } from '../lib/slug';

type PostEntry = CollectionEntry<'posts'>;
type CategoryEntry = CollectionEntry<'categories'>;

interface PostProps {
  post: PostEntry;
  slug: string;
  type?: 'post';
}

interface CategoryProps {
  category: CategoryEntry;
  slug: string;
  type: 'category';
}

type Props = PostProps | CategoryProps;

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const categories = await getCollection('categories');
  const usedSlugs = new Map<string, string>();
  const pagesDir = new URL('./', import.meta.url);

  const paths = posts.map((post) => {
    const slug = toPostSlug(post.id);

    if (!slug) {
      throw new Error(`Post "${post.id}" must contain at least one lowercase English letter or number for its URL.`);
    }

    const existingEntry = usedSlugs.get(slug);

    if (existingEntry) {
      throw new Error(`Posts "${existingEntry}" and "${post.id}" generate the same URL slug "${slug}".`);
    }

    usedSlugs.set(slug, post.id);

    return {
      params: { slug },
      props: { post, slug, type: 'post' } as PostProps,
    };
  });

  // Categories that have no dedicated static page (src/pages/<slug>.astro)
  // get a top-level archive route here. Posts and static pages win on conflicts.
  for (const category of categories) {
    const slug = category.id;

    if (!slug || usedSlugs.has(slug) || existsSync(new URL(`./${slug}.astro`, pagesDir))) {
      continue;
    }

    usedSlugs.set(slug, slug);

    paths.push({
      params: { slug },
      props: { category, slug, type: 'category' } as CategoryProps,
    });
  }

  return paths;
}

const props = Astro.props as Props;
const isCategory = props.type === 'category';
const { slug } = props;
const post = isCategory ? undefined : (props as PostProps).post;
const { Content } = post ? await render(post) : { Content: null };

const allCategories = (await getCollection('categories')).map((entry) => ({
  slug: entry.id,
  name: entry.data.name,
}));

const postData = post?.data;
const title = postData?.title ?? slug;
const description = postData?.description ?? '';
const pubDate = postData?.pubDate ?? new Date();
const updatedDate = postData?.updatedDate ?? pubDate;
const heroImage = postData?.heroImage ?? '/images/default-post.png';
const tags = postData?.tags ?? [];
const category = postData ? allCategories.find((item) => item.slug === postData.category) : undefined;
const canonicalUrl = `/${slug}`;
const publishedIso = pubDate.toISOString();
const updatedIso = updatedDate.toISOString();
const allPosts = await getCollection('posts');
const orderedPosts = allPosts
  .map((entry) => ({
    title: entry.data.title,
    pubDate: entry.data.pubDate,
    slug: toPostSlug(entry.id),
  }))
  .filter((entry) => entry.slug)
  .sort((a, b) => {
    const dateDiff = b.pubDate.getTime() - a.pubDate.getTime();
    return dateDiff || a.slug.localeCompare(b.slug);
  });

const currentPostIndex = orderedPosts.findIndex((entry) => entry.slug === slug);
const recommendedPosts =
  currentPostIndex === -1
    ? orderedPosts.slice(0, 10)
    : Array.from({ length: Math.min(10, Math.max(orderedPosts.length - 1, 0)) }, (_, index) => {
        const nextIndex = (currentPostIndex + index + 1) % orderedPosts.length;
        return orderedPosts[nextIndex];
      });

const metaKeywords = buildMetaKeywords({
  title,
  tags,
  categoryName: category?.name,
});

function formatDate(date: Date) {
  return new Intl.DateTimeFormat('zh-CN', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  }).format(date);
}

function buildMetaKeywords({
  title,
  tags,
  categoryName,
}: {
  title: string;
  tags: string[];
  categoryName?: string;
}) {
  const titleKeywords = title
    .split(/[|｜:：,，、;；!！?？()（）[\]【】/]+/)
    .map((value) => value.replace(/\s+/g, ' ').trim())
    .filter(Boolean)
    .slice(0, 3);

  if (titleKeywords.length === 0) {
    titleKeywords.push(title.trim());
  }

  const deduped = new Map<string, string>();

  for (const keyword of [...titleKeywords, ...(categoryName ? [categoryName] : []), ...tags]) {
    const normalized = keyword.replace(/\s+/g, ' ').trim();

    if (!normalized) continue;

    const key = normalized.toLowerCase();

    if (!deduped.has(key)) {
      deduped.set(key, normalized);
    }
  }

  return Array.from(deduped.values()).slice(0, 8);
}
---

{isCategory ? (
  <CategoryArchive categorySlug={slug} />
) : (
  <BaseLayout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  image={heroImage}
  schemaType="BlogPosting"
  datePublished={publishedIso}
  dateModified={updatedIso}
  keywords={metaKeywords}
>
  <div class="article-layout">
    <article class="article-shell glass-panel">
      <header class="article-header">
        <p class="article-kicker">SEO小平</p>
        <h1>{title}</h1>
        <p class="article-description">{description}</p>

        <div class="article-meta" aria-label="文章信息">
          <time datetime={publishedIso}>发布于 {formatDate(pubDate)}</time>
          <span aria-hidden="true">/</span>
          <time datetime={updatedIso}>更新于 {formatDate(updatedDate)}</time>
        </div>

        <div class="tag-list" aria-label="文章标签">
          {tags.map((tag) => (
            <a href={`/tag/${encodeURIComponent(tag)}`}>{tag}</a>
          ))}
        </div>
      </header>

      <PostCover image={heroImage} title={title} variant="hero" loading="eager" decoding="async" />

      <div class="article-content">
        <Content />
      </div>
    </article>

    <ArticleSidebar categories={allCategories} posts={recommendedPosts} />
  </div>
</BaseLayout>
)}

<style>
  .article-layout {
    display: grid;
    gap: 2rem;
    align-items: start;
  }

  .article-shell {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    padding: clamp(1.25rem, 4vw, 3rem);
    border-radius: 18px;
  }

  .article-header {
    display: grid;
    gap: 1rem;
  }

  .article-kicker {
    margin: 0;
    color: var(--color-primary);
    font-size: 0.92rem;
    font-weight: 850;
  }

  h1 {
    max-width: 60rem;
    margin: 0;
    color: var(--color-text);
    font-size: 2.05rem;
    font-weight: 900;
    line-height: 1.32;
    letter-spacing: 0;
  }

  .article-description {
    max-width: 58rem;
    margin: 0;
    color: rgba(255, 255, 255, 0.72);
    font-size: 1.14rem;
    line-height: 1.9;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    color: rgba(255, 255, 255, 0.56);
    font-size: 0.94rem;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .tag-list span,
  .tag-list a {
    border: 1px solid rgba(217, 83, 0, 0.26);
    border-radius: 18px;
    background: rgba(217, 83, 0, 0.16);
    color: var(--color-text);
    font-size: 0.86rem;
    font-weight: 750;
    line-height: 1;
    padding: 0.48rem 0.65rem;
    text-decoration: none;
  }

  .article-content {
    max-width: 60rem;
    color: rgba(255, 255, 255, 0.82);
    font-size: 1.04rem;
    line-height: 1.95;
    overflow-wrap: anywhere;
  }

  .article-content :global(*) {
    scroll-margin-top: 6rem;
  }

  .article-content :global(p),
  .article-content :global(ul),
  .article-content :global(ol),
  .article-content :global(blockquote),
  .article-content :global(pre),
  .article-content :global(table) {
    margin: 1.1rem 0;
  }

  .article-content :global(h2),
  .article-content :global(h3),
  .article-content :global(h4) {
    color: var(--color-text);
    font-weight: 850;
    line-height: 1.25;
    letter-spacing: 0;
  }

  .article-content :global(h2) {
    margin: 2.3rem 0 0.9rem;
    font-size: 2.05rem;
  }

  .article-content :global(h3) {
    margin: 1.8rem 0 0.75rem;
    font-size: 1.35rem;
  }

  .article-content :global(a) {
    color: var(--color-primary);
    font-weight: 750;
    text-decoration-thickness: 0.08em;
  }

  .article-content :global(strong) {
    color: var(--color-text);
    font-weight: 850;
  }

  .article-content :global(ul),
  .article-content :global(ol) {
    padding-left: 1.35rem;
  }

  .article-content :global(li + li) {
    margin-top: 0.45rem;
  }

  .article-content :global(blockquote) {
    border-left: 4px solid var(--color-primary);
    border-radius: 18px;
    background:
      linear-gradient(135deg, rgba(239, 125, 0, 0.12), rgba(255, 247, 215, 0.06)),
      rgba(255, 255, 255, 0.045);
    color: rgba(255, 255, 255, 0.76);
    padding: 0.85rem 1rem;
  }

  .article-content :global(table) {
    display: block;
    width: 100%;
    overflow-x: auto;
    border-collapse: separate;
    border-spacing: 0;
    border: 1px solid rgba(217, 83, 0, 0.22);
    border-radius: 18px;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.035)),
      rgba(23, 23, 28, 0.72);
    box-shadow: 0 18px 54px rgba(0, 0, 0, 0.22);
  }

  .article-content :global(th),
  .article-content :global(td) {
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    border-right: 1px solid rgba(255, 255, 255, 0.07);
    min-width: 10rem;
    padding: 0.85rem 0.95rem;
    text-align: left;
    vertical-align: top;
  }

  .article-content :global(th) {
    background: rgba(217, 83, 0, 0.16);
    color: var(--color-text);
    font-size: 0.92rem;
    font-weight: 900;
  }

  .article-content :global(td) {
    color: rgba(255, 255, 255, 0.78);
    font-size: 0.95rem;
    line-height: 1.75;
  }

  .article-content :global(tr:last-child td) {
    border-bottom: 0;
  }

  .article-content :global(th:last-child),
  .article-content :global(td:last-child) {
    border-right: 0;
  }

  .article-content :global(code) {
    border-radius: 6px;
    background: rgba(248, 233, 165, 0.16);
    color: #1f150f;
    font-size: 0.9em;
    padding: 0.15rem 0.35rem;
  }

  .article-content :global(pre) {
    overflow-x: auto;
    border: 1px solid rgba(245, 213, 92, 0.5);
    border-radius: 18px;
    background: linear-gradient(180deg, rgba(255, 247, 212, 0.97), rgba(246, 231, 162, 0.94));
    color: #1f150f;
    box-shadow: 0 18px 48px rgba(118, 80, 23, 0.18);
    padding: clamp(1rem, 2.8vw, 1.25rem);
  }

  .article-content :global(pre code) {
    display: block;
    white-space: pre-wrap;
    word-break: break-word;
    background: transparent;
    color: inherit;
    font-size: 0.95rem;
    line-height: 1.85;
    padding: 0;
  }

  .article-content :global(pre strong),
  .article-content :global(pre span),
  .article-content :global(pre em) {
    color: #1f150f;
  }

  .article-content :global(img) {
    border-radius: 18px;
  }

  .article-content :global(.content-lead) {
    margin: 0 0 1.6rem;
    border: 1px solid rgba(239, 125, 0, 0.2);
    border-radius: 18px;
    background:
      linear-gradient(135deg, rgba(255, 248, 229, 0.08), rgba(239, 125, 0, 0.08)),
      rgba(255, 255, 255, 0.045);
    box-shadow: 0 18px 44px rgba(239, 125, 0, 0.1);
    padding: clamp(1rem, 3vw, 1.45rem);
  }

  .article-content :global(.content-lead strong),
  .article-content :global(.insight-card strong),
  .article-content :global(.quote-card strong) {
    color: var(--color-primary);
  }

  .article-content :global(.insight-card),
  .article-content :global(.quote-card),
  .article-content :global(.action-list),
  .article-content :global(.figure-card) {
    margin: 1.4rem 0;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 18px;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.055), rgba(255, 255, 255, 0.035)),
      rgba(23, 23, 28, 0.72);
    box-shadow: 0 18px 48px rgba(0, 0, 0, 0.22);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    padding: clamp(1rem, 3vw, 1.35rem);
  }

  .article-content :global(.insight-card) {
    border-color: rgba(239, 125, 0, 0.2);
  }

  .article-content :global(.quote-card) {
    border-left: 5px solid var(--color-primary);
  }

  .article-content :global(.metric-strip) {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 1.4rem 0;
  }

  .article-content :global(.metric-strip > div) {
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 18px;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.055), rgba(255, 255, 255, 0.035)),
      rgba(23, 23, 28, 0.72);
    padding: 1rem;
  }

  .article-content :global(.metric-strip span) {
    display: block;
    color: var(--color-primary);
    font-size: 0.84rem;
    font-weight: 850;
  }

  .article-content :global(.metric-strip strong) {
    display: block;
    margin-top: 0.35rem;
    color: var(--color-text);
    font-size: 1.05rem;
    line-height: 1.35;
  }

  .article-content :global(.comparison-grid) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin: 1.5rem 0;
  }

  .article-content :global(.comparison-grid > div) {
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 18px;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.055), rgba(255, 255, 255, 0.035)),
      rgba(23, 23, 28, 0.72);
    padding: 1.1rem;
  }

  .article-content :global(.comparison-grid h3) {
    margin-top: 0;
    color: var(--color-primary);
    font-size: 1.08rem;
  }

  .article-content :global(.action-list ol),
  .article-content :global(.action-list ul) {
    margin-bottom: 0;
  }

  .article-content :global(.figure-card img) {
    width: 100%;
    box-shadow: 0 18px 54px rgba(0, 0, 0, 0.28);
  }

  .article-content :global(.figure-card figcaption) {
    margin-top: 0.7rem;
    color: rgba(255, 255, 255, 0.58);
    font-size: 0.9rem;
    line-height: 1.7;
  }

  @media (max-width: 680px) {
    h1 {
      max-width: 100%;
      font-size: 1.55rem;
    }

    .article-shell {
      padding: 1rem;
    }

    .article-description {
      font-size: 1rem;
    }

    .article-content :global(h2) {
      font-size: 1.55rem;
    }

    .article-content :global(.metric-strip),
    .article-content :global(.comparison-grid) {
      grid-template-columns: 1fr;
    }
  }

  @media (min-width: 1080px) {
    .article-layout {
      grid-template-columns: minmax(0, 1fr) 20rem;
    }

    .article-layout :global(aside) {
      position: sticky;
      top: 6rem;
    }
  }
</style>
