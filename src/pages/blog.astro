---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { toPostSlug } from '../lib/slug';

const [blogIndex] = await getCollection('blog_index');
const settings = blogIndex?.data;
const pageTitle = settings?.title ?? '博客';
const pageDescription =
  settings?.description ?? 'SEO小平全部博客文章列表。';

const posts = (await getCollection('posts'))
  .map((post) => ({
    title: post.data.title,
    description: post.data.description,
    pubDate: post.data.pubDate,
    slug: toPostSlug(post.id),
  }))
  .filter((post) => post.slug)
  .sort((a, b) => b.pubDate.getTime() - a.pubDate.getTime());

const postsByYear = new Map<number, typeof posts>();

for (const post of posts) {
  const year = post.pubDate.getFullYear();
  const group = postsByYear.get(year) ?? [];
  group.push(post);
  postsByYear.set(year, group);
}

const years = Array.from(postsByYear.keys()).sort((a, b) => b - a);

const dateFormatter = new Intl.DateTimeFormat('zh-CN', {
  month: '2-digit',
  day: '2-digit',
});
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl="/blog"
  keywords={['博客', 'SEO小平', '谷歌SEO', '独立站SEO']}
>
  <section class="grid gap-8 py-10" aria-labelledby="blog-title">
    <header class="rounded-2xl border border-white/10 bg-white/5 p-8 shadow-[0_24px_80px_rgba(0,0,0,0.25)] backdrop-blur-md">
      <p class="mb-3 text-sm font-black text-[#f59e0b]">Blog</p>
      <h1 id="blog-title" class="mb-4 text-4xl font-black leading-tight tracking-tight text-white">{pageTitle}</h1>
      <p class="max-w-3xl text-lg leading-8 text-white/72">{pageDescription}</p>
    </header>

    {years.map((year) => (
      <div class="grid gap-4">
        <h2 class="text-xl font-black tracking-tight text-white">
          {year}
          <span class="ml-2 text-sm font-bold text-white/45">{postsByYear.get(year)?.length ?? 0} 篇</span>
        </h2>
        <ul class="grid gap-2">
          {postsByYear.get(year)?.map((post) => (
            <li>
              <a
                href={`/${post.slug}`}
                class="flex flex-wrap items-baseline gap-x-4 gap-y-1 rounded-xl border border-white/10 bg-white/5 px-5 py-3.5 transition hover:border-[#d95300]/40 hover:bg-[#d95300]/10"
              >
                <time datetime={post.pubDate.toISOString()} class="w-14 shrink-0 text-xs font-bold text-[#f59e0b]">
                  {dateFormatter.format(post.pubDate)}
                </time>
                <span class="text-sm font-extrabold leading-6 text-white/85">{post.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>
</BaseLayout>