---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="联系SEO小平"
  description="联系 SEO小平，咨询谷歌 SEO、独立站 SEO、小语种 SEO、GEO 与内容工程陪跑服务。"
  canonicalUrl="/contact"
  keywords={['SEO小平', 'SEO咨询', '谷歌SEO陪跑', '独立站SEO']}
>
  <section class="grid gap-8 py-12" aria-labelledby="contact-title">
    <div class="rounded-2xl border border-white/10 bg-white/5 p-8 shadow-[0_24px_80px_rgba(0,0,0,0.25)] backdrop-blur-md">
      <p class="mb-3 text-sm font-black text-[#f59e0b]">Contact</p>
      <h1 id="contact-title" class="mb-4 text-4xl font-black leading-tight tracking-tight text-white">联系SEO小平</h1>
      <p class="max-w-3xl text-lg leading-8 text-white/72">
        如果你正在做外贸独立站、谷歌 SEO、小语种 SEO 或 GEO 流量布局，可以通过微信或邮箱联系我。
      </p>
    </div>

    <div class="grid gap-5 md:grid-cols-2">
      <article class="rounded-2xl border border-white/10 bg-white/5 p-6 shadow-[0_18px_54px_rgba(0,0,0,0.2)] backdrop-blur-md">
        <div class="mb-4 grid h-12 w-12 place-items-center rounded-xl bg-white/5 text-xl text-[#f59e0b]">
          <i class="fa-brands fa-weixin" aria-hidden="true"></i>
        </div>
        <h2 class="mb-2 text-xl font-black tracking-tight text-white">微信咨询</h2>
        <p class="text-white/72">Xiao_Ping_Up</p>
      </article>

      <article class="rounded-2xl border border-white/10 bg-white/5 p-6 shadow-[0_18px_54px_rgba(0,0,0,0.2)] backdrop-blur-md">
        <div class="mb-4 grid h-12 w-12 place-items-center rounded-xl bg-white/5 text-xl text-[#f59e0b]">
          <i class="fa-solid fa-envelope" aria-hidden="true"></i>
        </div>
        <h2 class="mb-2 text-xl font-black tracking-tight text-white">邮箱联系</h2>
        <a class="font-bold text-[#f59e0b] transition hover:text-white" href="mailto:hello@seogeo.cc">hello@seogeo.cc</a>
      </article>
    </div>
  </section>
</BaseLayout>
