---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCover from '../../components/PostCover.astro';

type PageEntry = CollectionEntry<'pages'>;

interface Props {
  page: PageEntry;
  slug: string;
}

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  const usedSlugs = new Set<string>();

  return pages.map((page) => {
    const slug = page.id;

    if (!slug) {
      throw new Error(`Page "${page.id}" must have a file name for its URL.`);
    }

    if (usedSlugs.has(slug)) {
      throw new Error(`Pages generate the same URL slug "${slug}".`);
    }

    usedSlugs.add(slug);

    return {
      params: { slug },
      props: { page, slug },
    };
  });
}

const { page, slug } = Astro.props as Props;
const { Content } = await render(page);
const { title, description, heroImage } = page.data;
const canonicalUrl = `/p/${slug}`;
---

<BaseLayout title={title} description={description} canonicalUrl={canonicalUrl} image={heroImage}>
  <article class="page-shell glass-panel">
    <header class="page-header">
      <p class="page-kicker">SEO小平</p>
      <h1>{title}</h1>
      <p class="page-description">{description}</p>
    </header>

    {heroImage && <PostCover image={heroImage} title={title} variant="hero" loading="eager" decoding="async" />}

    <div class="page-content">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .page-shell {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    padding: clamp(1.25rem, 4vw, 3rem);
    border-radius: 18px;
  }

  .page-header {
    display: grid;
    gap: 1rem;
  }

  .page-kicker {
    margin: 0;
    color: var(--color-primary);
    font-size: 0.92rem;
    font-weight: 850;
  }

  h1 {
    max-width: 60rem;
    margin: 0;
    color: var(--color-text);
    font-size: 2.05rem;
    font-weight: 900;
    line-height: 1.32;
  }

  .page-description {
    max-width: 58rem;
    margin: 0;
    color: rgba(255, 255, 255, 0.72);
    font-size: 1.14rem;
    line-height: 1.9;
  }

  .page-content {
    max-width: 60rem;
    color: rgba(255, 255, 255, 0.82);
    font-size: 1.04rem;
    line-height: 1.95;
    overflow-wrap: anywhere;
  }

  .page-content :global(h2),
  .page-content :global(h3),
  .page-content :global(h4) {
    color: var(--color-text);
    font-weight: 850;
    line-height: 1.25;
  }

  .page-content :global(h2) {
    margin: 2.3rem 0 0.9rem;
    font-size: 2.05rem;
  }

  .page-content :global(h3) {
    margin: 1.8rem 0 0.75rem;
    font-size: 1.35rem;
  }

  .page-content :global(p),
  .page-content :global(ul),
  .page-content :global(ol),
  .page-content :global(blockquote),
  .page-content :global(pre),
  .page-content :global(table) {
    margin: 1.1rem 0;
  }

  .page-content :global(a) {
    color: var(--color-primary);
    font-weight: 750;
    text-decoration-thickness: 0.08em;
  }

  .page-content :global(strong) {
    color: var(--color-text);
    font-weight: 850;
  }

  .page-content :global(ul),
  .page-content :global(ol) {
    padding-left: 1.35rem;
  }

  .page-content :global(li + li) {
    margin-top: 0.45rem;
  }

  .page-content :global(blockquote) {
    border-left: 4px solid var(--color-primary);
    border-radius: 18px;
    background:
      linear-gradient(135deg, rgba(239, 125, 0, 0.12), rgba(255, 247, 215, 0.06)),
      rgba(255, 255, 255, 0.045);
    color: rgba(255, 255, 255, 0.76);
    padding: 0.85rem 1rem;
  }

  .page-content :global(img) {
    border-radius: 18px;
  }

  .page-content :global(code) {
    border-radius: 6px;
    background: rgba(248, 233, 165, 0.16);
    color: #1f150f;
    font-size: 0.9em;
    padding: 0.15rem 0.35rem;
  }

  .page-content :global(pre) {
    overflow-x: auto;
    border: 1px solid rgba(245, 213, 92, 0.5);
    border-radius: 18px;
    background: linear-gradient(180deg, rgba(255, 247, 212, 0.97), rgba(246, 231, 162, 0.94));
    color: #1f150f;
    padding: clamp(1rem, 2.8vw, 1.25rem);
  }

  .page-content :global(pre code) {
    display: block;
    white-space: pre-wrap;
    word-break: break-word;
    background: transparent;
    color: inherit;
    font-size: 0.95rem;
    line-height: 1.85;
    padding: 0;
  }

  @media (max-width: 680px) {
    h1 {
      font-size: 1.55rem;
    }

    .page-shell {
      padding: 1rem;
    }

    .page-description {
      font-size: 1rem;
    }

    .page-content :global(h2) {
      font-size: 1.55rem;
    }
  }
</style>