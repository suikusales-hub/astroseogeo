---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "美国邮编查询 - 免费精准地图定位 | 按地址与邮编互查 v2";
const description = "美国邮编大全，支持按城市、地址快速查找美国主要邮政编码。提供真实的地图定位、邮编详情、包裹附加费预估及常见FAQ等一站式跨境物流信息。";
---

<BaseLayout
  title={title}
  description={description}
  canonicalUrl="/us-zip-code-lookup"
