<script>
  // Leaflet CDN
  const leafletCSS = document.createElement('link');
  leafletCSS.rel = 'stylesheet';
  leafletCSS.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
  leafletCSS.crossOrigin = '';
  document.head.appendChild(leafletCSS);

  const leafletJS = document.createElement('script');
  leafletJS.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
  leafletJS.crossOrigin = '';
  leafletJS.onload = initMaps;
  document.head.appendChild(leafletJS);

  let zipMapObj = null;
  let addrMapObj = null;
  let zipMarker = null;
  let addrMarker = null;

  function initMaps() {
    zipMapObj = L.map('zipMap').setView([39.8283, -98.5795], 4);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '© OpenStreetMap'
    }).addTo(zipMapObj);

    addrMapObj = L.map('addrMap').setView([39.8283, -98.5795], 4);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '© OpenStreetMap'
    }).addTo(addrMapObj);
  }

  async function lookupZip() {
    const code = document.getElementById('zipCodeInput').value.trim();
    if(!code || code.length !== 5) {
      alert("请输入标准的 5 位数字美国邮编！");
      return;
    }
    const loading = document.getElementById('zipLoading');
    loading.classList.add('active');
    try {
      const response = await fetch(`https://api.zippopotam.us/us/${code}`);
      if (!response.ok) throw new Error("无法找到该邮编，请核实后重试");
      const data = await response.json();
      const place = data.places[0];
      document.getElementById('resZipType').textContent = "标准邮编";
      document.getElementById('resZipCity').textContent = place['place name'];
      document.getElementById('resZipState').textContent = place['state abbreviation'] + " (" + place['state'] + ")";
      document.getElementById('resZipUps').textContent = "正常，无偏远附加费";
      document.getElementById('resZipFedex').textContent = "正常，无偏远附加费";
      document.getElementById('zipMapStatus').classList.add('hidden');
      const lat = parseFloat(place.latitude);
      const lon = parseFloat(place.longitude);
      if(zipMarker) zipMapObj.removeLayer(zipMarker);
      zipMarker = L.marker([lat, lon]).addTo(zipMapObj);
      zipMarker.bindPopup(`<b>${place['place name']}, ${place['state abbreviation']}</b><br>ZIP: ${code}`).openPopup();
      zipMapObj.flyTo([lat, lon], 12);
    } catch (error) {
      alert(error.message);
    } finally {
      loading.classList.remove('active');
    }
  }

  async function lookupAddress() {
    const address = document.getElementById('addressInput').value.trim();
    if(!address) {
      alert("请输入需要解析的美国地址！");
      return;
    }
    const loading = document.getElementById('addrLoading');
    loading.classList.add('active');
    try {
      const query = encodeURIComponent(address);
      const response = await fetch(`https://nominatim.openstreetmap.org/search?q=${query}&countrycodes=us&format=json&addressdetails=1&limit=1`, {
        headers: { 'Accept-Language': 'en-US,en' }
      });
      const data = await response.json();
      if (data && data.length > 0) {
        const result = data[0];
        const addrInfo = result.address;
        const zip = addrInfo.postcode || "未找到精确邮编";
        const city = addrInfo.city || addrInfo.town || addrInfo.village || addrInfo.county || "未知城市";
        const state = addrInfo.state || "未知州";
        document.getElementById('resAddrFull').textContent = result.display_name;
        document.getElementById('resAddrCity').textContent = city;
        document.getElementById('resAddrState').textContent = state;
        document.getElementById('resAddrZip').textContent = zip;
        document.getElementById('addrMapStatus').classList.add('hidden');
        const lat = parseFloat(result.lat);
        const lon = parseFloat(result.lon);
        if(addrMarker) addrMapObj.removeLayer(addrMarker);
        addrMarker = L.marker([lat, lon]).addTo(addrMapObj);
        addrMarker.bindPopup(`<b>${city}, ${state}</b><br>提取的 ZIP: ${zip}`).openPopup();
        addrMapObj.flyTo([lat, lon], 14);
      } else {
        throw new Error("抱歉，无法精确解析该地址。请尝试补充街道或城市名称，并确保拼写正确。");
      }
    } catch (error) {
      alert(error.message);
    } finally {
      loading.classList.remove('active');
    }
  }
</script>
